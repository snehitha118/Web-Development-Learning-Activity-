
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sweet Cravings | Bakery & Cake Shop</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #fffaf5;
    color: #49352c;
}

html {
    scroll-behavior: smooth;
}

/* HEADER */
header {
    background: #fff;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    box-shadow: 0 3px 12px #00000010;
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 26px;
    font-weight: bold;
    color: #c65d75;
}

nav a {
    text-decoration: none;
    color: #49352c;
    margin-left: 18px;
    font-weight: bold;
}

nav a:hover {
    color: #c65d75;
}

/* HERO */
.hero {
    min-height: 440px;
    padding: 80px 7%;
    display: flex;
    align-items: center;
    background:
    linear-gradient(90deg, #3c211dcc, #3c211d55),
    url("https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=1600")
    center/cover;
    color: white;
}

.hero-content {
    max-width: 600px;
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 25px;
}

.main-btn {
    display: inline-block;
    padding: 13px 25px;
    background: #e77b94;
    color: white;
    text-decoration: none;
    border-radius: 25px;
    font-weight: bold;
}

/* COMMON */
.container {
    padding: 55px 7%;
}

.section-title {
    text-align: center;
    font-size: 30px;
    color: #a94f65;
    margin-bottom: 12px;
}

.section-subtitle {
    text-align: center;
    color: #8b7770;
    margin-bottom: 30px;
}

/* OFFERS */
.offer {
    margin: 0 7%;
    padding: 30px;
    border-radius: 15px;
    text-align: center;
    background: #f9dce3;
    color: #8d3c53;
}

.offer h2 {
    font-size: 28px;
    margin-bottom: 10px;
}

.offer p {
    margin: 8px;
}

/* FILTERS */
.filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
}

.filters button {
    padding: 10px 20px;
    border: 1px solid #d77b91;
    border-radius: 20px;
    background: white;
    color: #a94f65;
    cursor: pointer;
}

.filters button.active,
.filters button:hover {
    background: #c65d75;
    color: white;
}

/* PRODUCT GRID */
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 25px;
}

.product-card {
    background: white;
    border-radius: 13px;
    overflow: hidden;
    box-shadow: 0 4px 15px #00000012;
    transition: 0.3s;
}

.product-card:hover {
    transform: translateY(-6px);
}

.product-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.product-info {
    padding: 18px;
    text-align: center;
}

.product-info h3 {
    margin-bottom: 10px;
}

.product-info p {
    color: #88736b;
    font-size: 14px;
    margin-bottom: 12px;
    line-height: 1.5;
}

.price {
    color: #b74d67 !important;
    font-size: 20px !important;
    font-weight: bold;
}

.cart-btn {
    width: 100%;
    padding: 11px;
    border: none;
    background: #c65d75;
    color: white;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
}

.cart-btn:hover {
    background: #a9435c;
}

/* CUSTOM CAKES */
.custom-section {
    background: #f9e9e8;
    text-align: center;
}

.custom-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    margin-top: 30px;
}

.custom-grid img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 12px;
}

.custom-grid h3 {
    margin-top: 12px;
}

/* CONTACT */
.contact {
    background: #49352c;
    color: white;
    text-align: center;
}

.contact h2 {
    color: #ffc5d2;
    margin-bottom: 20px;
}

.contact p {
    margin: 12px;
    color: #f1ded6;
}

.contact a {
    color: #ffc5d2;
}

/* CART */
.cart-box {
    background: white;
    padding: 25px;
    border-radius: 12px;
    margin-top: 30px;
    box-shadow: 0 3px 15px #00000010;
}

.cart-box h2 {
    margin-bottom: 15px;
    color: #a94f65;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin: 12px 0;
    padding-bottom: 10px;
    border-bottom: 1px solid #eee;
}

.remove-btn {
    color: #c65d75;
    border: none;
    background: none;
    cursor: pointer;
}

.total {
    font-size: 20px;
    font-weight: bold;
    margin: 20px 0;
}

.checkout-btn {
    padding: 12px 22px;
    background: #c65d75;
    color: white;
    border: none;
    border-radius: 7px;
    cursor: pointer;
}

footer {
    text-align: center;
    padding: 22px;
    background: #33231f;
    color: #eee;
}

.empty {
    text-align: center;
    grid-column: 1/-1;
}

@media(max-width:600px) {
    header {
        justify-content: center;
    }

    nav a {
        margin: 7px;
        font-size: 13px;
    }

    .hero h1 {
        font-size: 34px;
    }

    .hero {
        min-height: 380px;
    }

    .container {
        padding: 40px 5%;
    }
}
</style>
</head>

<body>

<!-- HEADER -->
<header>
    <div class="logo">🍰 Sweet Cravings</div>

    <nav>
        <a href="#">Home</a>
        <a href="#products">Menu</a>
        <a href="#custom">Custom Cakes</a>
        <a href="#cart">Cart 🛒 (<span id="cartCount">0</span>)</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<!-- HERO SECTION -->
<section class="hero">
    <div class="hero-content">
        <h1>Freshly Baked With Love ❤️</h1>

        <p>
            Welcome to Sweet Cravings! Discover delicious cakes,
            creamy pastries and freshly baked cookies made with
            love and the finest ingredients.
        </p>

        <a href="#products" class="main-btn">Explore Our Menu</a>
    </div>
</section>

<!-- SPECIAL OFFER -->
<section class="container">
    <div class="offer">
        <h2>🎉 Sweet Seasonal Offers!</h2>
        <p>Enjoy 15% OFF on selected cakes this festive season.</p>
        <p><strong>Use Code: SWEET15</strong></p>
        <p>Limited-time promotional offer!</p>
    </div>
</section>

<!-- PRODUCTS -->
<section class="container" id="products">

    <h2 class="section-title">Our Delicious Collection</h2>

    <p class="section-subtitle">
        Freshly prepared treats for every special moment.
    </p>

    <div class="filters">
        <button class="active" onclick="filterProducts('All',this)">All</button>
        <button onclick="filterProducts('Cakes',this)">Cakes</button>
        <button onclick="filterProducts('Pastries',this)">Pastries</button>
        <button onclick="filterProducts('Cookies',this)">Cookies</button>
    </div>

    <div class="product-grid" id="productGrid"></div>

</section>

<!-- CUSTOM CAKES -->
<section class="container custom-section" id="custom">

    <h2 class="section-title">Custom Cake Designs 🎂</h2>

    <p class="section-subtitle">
        Make your celebrations unforgettable with our customized cakes.
    </p>

    <div class="custom-grid">

        <div>
            <img src="https://images.unsplash.com/photo-1535254973040-607b474cb50d?w=600" alt="Birthday cake">
            <h3>Birthday Cakes</h3>
        </div>

        <div>
            <img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=600" alt="Wedding cake">
            <h3>Wedding Cakes</h3>
        </div>

        <div>
            <img src="https://images.unsplash.com/photo-1464349095431-e9a21285b5f3?w=600" alt="Celebration cake">
            <h3>Theme Cakes</h3>
        </div>

    </div>

    <br><br>

    <a href="#contact" class="main-btn">Order Custom Cake</a>

</section>

<!-- SHOPPING CART -->
<section class="container" id="cart">

    <div class="cart-box">

        <h2>🛒 Your Shopping Cart</h2>

        <div id="cartItems">
            Your cart is empty.
        </div>

        <p class="total">
            Total: ₹<span id="total">0</span>
        </p>

        <button class="checkout-btn" onclick="checkout()">
            Place Order
        </button>

    </div>

</section>

<!-- CONTACT -->
<section class="container contact" id="contact">

    <h2>Visit Our Bakery ❤️</h2>

    <p>📍 Address: Main Road, Nuzvid, Andhra Pradesh</p>

    <p>📞 Phone: +91 98765 43210</p>

    <p>📧 Email: sweetcravings@example.com</p>

    <p>🕒 Opening Hours: 9:00 AM – 9:00 PM</p>

    <p>Instagram: <a href="https://www.instagram.com/" target="_blank">Follow Us</a></p>

</section>

<footer>
    <h3>🍰 Sweet Cravings Bakery</h3>
    <p>Making Every Celebration Sweeter!</p>
    <p>© 2026 Sweet Cravings. All Rights Reserved.</p>
</footer>

<script>

// PRODUCT DETAILS

const products = [

{
    name: "Chocolate Truffle Cake",
    category: "Cakes",
    price: 650,
    image: "https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600",
    description: "Rich chocolate cake with smooth chocolate ganache."
},

{
    name: "Strawberry Cake",
    category: "Cakes",
    price: 550,
    image: "https://images.unsplash.com/photo-1565958011703-44f9829ba187?w=600",
    description: "Fresh strawberry cake with delicious cream."
},

{
    name: "Red Velvet Cake",
    category: "Cakes",
    price: 750,
    image: "https://images.unsplash.com/photo-1586788680434-30d324b2d46f?w=600",
    description: "Soft red velvet sponge with cream cheese frosting."
},

{
    name: "Black Forest Pastry",
    category: "Pastries",
    price: 90,
    image: "https://images.unsplash.com/photo-1488477181946-6428a0291777?w=600",
    description: "Chocolate pastry with cherries and fresh cream."
},

{
    name: "Vanilla Pastry",
    category: "Pastries",
    price: 80,
    image: "https://images.unsplash.com/photo-1483695028939-5bb13f8648b0?w=600",
    description: "Classic vanilla pastry with soft creamy layers."
},

{
    name: "Chocolate Cookies",
    category: "Cookies",
    price: 150,
    image: "https://images.unsplash.com/photo-1499636136210-6f4ee915583e?w=600",
    description: "Crunchy cookies filled with chocolate chips."
},

{
    name: "Butter Cookies",
    category: "Cookies",
    price: 120,
    image: "https://images.unsplash.com/photo-1558961363-fa8fdf82db35?w=600",
    description: "Freshly baked buttery and crispy cookies."
},

{
    name: "Cupcakes",
    category: "Cakes",
    price: 100,
    image: "https://images.unsplash.com/photo-1486427944299-d1955d23e34d?w=600",
    description: "Beautiful cupcakes topped with delicious frosting."
}

];

let cart = [];
let currentCategory = "All";

const grid = document.getElementById("productGrid");

// DISPLAY PRODUCTS

function displayProducts(list) {

    grid.innerHTML = "";

    if(list.length === 0) {
        grid.innerHTML = '<p class="empty">No products found!</p>';
        return;
    }

    list.forEach(product => {

        const index = products.indexOf(product);

        const card = document.createElement("div");

        card.className = "product-card";

        card.innerHTML = `

            <img src="${product.image}" alt="${product.name}">

            <div class="product-info">

                <h3>${product.name}</h3>

                <p>${product.description}</p>

                <p class="price">₹${product.price}</p>

                <button class="cart-btn"
                    onclick="addToCart(${index})">
                    Add to Cart 🛒
                </button>

            </div>
        `;

        grid.appendChild(card);

    });

}

// FILTER PRODUCTS

function filterProducts(category,button) {

    currentCategory = category;

    document.querySelectorAll(".filters button")
    .forEach(btn => btn.classList.remove("active"));

    button.classList.add("active");

    const filtered = currentCategory === "All"
        ? products
        : products.filter(p => p.category === category);

    displayProducts(filtered);

}

// ADD TO CART

function addToCart(index) {

    cart.push(products[index]);

    updateCart();

    alert(products[index].name + " added to your cart!");

}

// REMOVE ITEM

function removeItem(index) {

    cart.splice(index,1);

    updateCart();

}

// UPDATE CART

function updateCart() {

    const cartItems = document.getElementById("cartItems");

    const cartCount = document.getElementById("cartCount");

    let total = 0;

    cartCount.innerText = cart.length;

    if(cart.length === 0) {
        cartItems.innerHTML = "Your cart is empty.";
    }
    else {

        cartItems.innerHTML = "";

        cart.forEach((item,index) => {

            total += item.price;

            const row = document.createElement("div");

            row.className = "cart-item";

            row.innerHTML = `
                <span>${item.name} - ₹${item.price}</span>

                <button class="remove-btn"
                    onclick="removeItem(${index})">
                    Remove ✖
                </button>
            `;

            cartItems.appendChild(row);

        });

    }

    document.getElementById("total").innerText = total;

}

// CHECKOUT

function checkout() {

    if(cart.length === 0) {
        alert("Please add products to your cart first!");
        return;
    }

    alert("Thank you for shopping at Sweet Cravings! Your demo order has been placed.");

    cart = [];

    updateCart();

}

// INITIAL DISPLAY

displayProducts(products);

</script>

</body>
</html>

